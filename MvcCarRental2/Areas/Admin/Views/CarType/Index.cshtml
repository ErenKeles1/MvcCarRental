@model List<MvcCarRental2.Web.Domain.CarType>

@{
    ViewData["Title"] = "Araç Türleri";
    
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0">Araç Türleri</h3>
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Yeni Tür Ekle
                    </a>
                </div>
                <div class="card-body">
                    @if (Model != null && Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        
                                        <th>Tür Adı</th>
                                        <th class="text-center">İşlemler</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var carType in Model)
                                    {
                                        <tr>
                                            
                                            <td>@carType.Name</td>
                                            <td class="text-center">
                                                <div class="btn-group" role="group">
                                                    <a asp-action="Edit"
                                                       asp-route-id="@carType.Id"
                                                       class="btn btn-sm btn-warning">
                                                        <i class="fas fa-edit"></i> Düzenle
                                                    </a>

                                                    <form asp-action="Delete" asp-route-id="@carType.Id" method="post" style="display: inline;">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-danger">
                                                            <i class="fas fa-trash"></i> Sil
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info text-center">
                            <i class="fas fa-info-circle"></i>
                            Henüz araç türü bulunmamaktadır.
                            <a asp-action="Create" class="btn btn-primary btn-sm ms-2">
                                İlk araç türünü ekleyin
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>



