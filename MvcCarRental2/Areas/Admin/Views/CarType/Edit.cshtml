
@model MvcCarRental2.Web.Areas.Admin.Models.CarTypeViewModel
@{
    ViewData["Title"] = "Edit Car Type";
}
<h1>Edit Car Type</h1>
<form asp-action="Edit" method="post">
    <input asp-for="Id" type="hidden" />
    <div class="mb-3">
        <label asp-for="Name" class="form-label">Car Type Name</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Update</button>
</form>
<a href="@Url.Action("Index")" class="btn btn-secondary mt-3">Back to List</a>