@model MvcCarRental2.Web.Areas.Admin.Models.CarViewModel
@using MvcCarRental2.Web.Domain

@{
    
}

<div class="container mt-4">
    <h1 class="mb-4">Yeni Araç Ekle</h1>

    <div class="row">
        <div class="col-md-8 col-lg-6">
            <form asp-action="Create" method="post">

                @* Genel Hata Mesajları İçin Validation Summary *@
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                @* Plaka Numarası *@
                <div class="mb-3">
                    <label asp-for="PlateNumber" class="form-label">Plaka</label>
                    <input asp-for="PlateNumber" class="form-control" placeholder="Örn: 34 ABC 123" />
                    <span asp-validation-for="PlateNumber" class="text-danger"></span>
                </div>

                @* Model Seçimi (Controller'dan ViewBag.Models ile doldurulmalı) *@
            <div class="mb-3">
                <label asp-for="ModelId" class="form-label">Model</label>
                <select asp-for="ModelId" class="form-select" asp-items="ViewBag.Models">
                    <option value="">Lütfen bir model seçin...</option>
                </select>
                <span asp-validation-for="ModelId" class="text-danger"></span>
            </div>

                @* Üretim Yılı *@
                <div class="mb-3">
                    <label asp-for="Year" class="form-label">Yıl</label>
                    <input asp-for="Year" type="number" class="form-control" placeholder="Örn: 2023" />
                    <span asp-validation-for="Year" class="text-danger"></span>
                </div>

                @* Fiyat *@
                <div class="mb-3">
                    <label asp-for="Price" class="form-label">Günlük Fiyat (₺)</label>
                    <input asp-for="Price" type="number" step="0.01" class="form-control" placeholder="Örn: 1500.50" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>

                @* Vites Tipi *@
                <div class="mb-3">
                    <label asp-for="TransmissionType" class="form-label">Vites Tipi</label>
                    <select asp-for="TransmissionType" class="form-select" asp-items="Html.GetEnumSelectList<TransmissionTypes>()">
                        <option value="">Lütfen vites tipi seçin...</option>
                    </select>
                    <span asp-validation-for="TransmissionType" class="text-danger"></span>
                </div>

                @* Resim Adresi *@
                <div class="mb-3">
                    <label asp-for="ImageAdress" class="form-label">Resim URL</label>
                    <input asp-for="ImageAdress" class="form-control" placeholder="https://ornek.com/resim.jpg" />
                    <span asp-validation-for="ImageAdress" class="text-danger"></span>
                </div>

                <hr class="my-4" />

                @* Butonlar *@
                <div class="d-flex justify-content-end">
                    <a asp-action="Index" class="btn btn-secondary me-2">İptal</a>
                    <button type="submit" class="btn btn-primary">Kaydet</button>
                </div>
            </form>
        </div>
    </div>
</div>

