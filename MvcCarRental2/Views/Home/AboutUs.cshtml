@{
    ViewBag.Title = "Hakkımızda";

}

<!-- Hero -->
<section class="bg-dark text-light">
    <div class="container py-5">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <span class="badge bg-warning text-dark mb-3 fw-semibold">Kurumsal</span>
                <h1 class="display-5 fw-bold mb-3">E&A Motors hakkında</h1>
                <p class="lead mb-4">
                    2004’ten bu yana; güvenli, şeffaf ve konforlu araç kiralama deneyimini
                    herkes için erişilebilir kılıyoruz. Genç filomuz ve 7/24 destek ekibimizle yanındayız.
                </p>
                <div class="d-flex gap-2">
                    <a href="~/Home/Products" class="btn btn-warning fw-semibold">Araçlarımız</a>
                    <a href="~/Home/Contact" class="btn btn-outline-light">İletişime geç</a>
                </div>
            </div>
            <div class="col-lg-5">
                <img src="~/images/banner2.png" class="img-fluid rounded-4 shadow" alt="Ofis ve araç görseli">
            </div>
        </div>
    </div>
</section>

<!-- Hakkımızda metni -->
<section class="bg-light">
    <div class="container py-5">
        <div class="row g-5">
            <div class="col-lg-6">
                <h2 class="h3 fw-bold mb-3">Hikayemiz</h2>
                <p class="mb-3">
                    “Önce müşteri memnuniyeti” yaklaşımıyla çıktığımız yolda; sorunsuz teslim,
                    hızlı iade ve şeffaf sözleşme ilkelerini benimsedik. İstanbul ve çevre illerde
                    bireysel ve kurumsal müşterilerimize hizmet veriyoruz.
                </p>
                <p class="mb-0">
                    Lüks ve orta segment seçeneklerimizi, bakımlı ve düşük kilometreli araçlardan
                    oluşturuyor; ihtiyaca göre günlük, haftalık ve aylık kiralama alternatifleri sunuyoruz.
                </p>
            </div>
            <div class="col-lg-6">
                <div class="row g-3">
                    <div class="col-6">
                        <div class="card h-100 border-0 shadow-sm rounded-4">
                            <div class="card-body">
                                <h3 class="h1 mb-1">20+</h3>
                                <p class="text-muted mb-0">Yıllık tecrübe</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="card h-100 border-0 shadow-sm rounded-4">
                            <div class="card-body">
                                <h3 class="h1 mb-1">7/24</h3>
                                <p class="text-muted mb-0">Yol yardım</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="card h-100 border-0 shadow-sm rounded-4">
                            <div class="card-body">
                                <h3 class="h1 mb-1">50+</h3>
                                <p class="text-muted mb-0">Araç seçeneği</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="card h-100 border-0 shadow-sm rounded-4">
                            <div class="card-body">
                                <h3 class="h1 mb-1">%98</h3>
                                <p class="text-muted mb-0">Memnuniyet oranı</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Neden Biz -->
<section class="py-5">
    <div class="container py-5">
        <div class="row g-5 align-items-center">
            <div class="col-lg-6">
                <img src="~/images/tslm.jpg" class="img-fluid rounded-4 shadow" alt="Araç teslim anı">
            </div>
            <div class="col-lg-6">
                <h2 class="h3 fw-bold mb-3">Neden E&A Motors?</h2>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item px-0 d-flex">
                        <i class="bi bi-shield-check me-3 fs-4 text-warning"></i>
                        Şeffaf sözleşme, gizli masraf yok.
                    </li>
                    <li class="list-group-item px-0 d-flex">
                        <i class="bi bi-clock-history me-3 fs-4 text-warning"></i>
                        Hızlı teslim & pratik iade.
                    </li>
                    <li class="list-group-item px-0 d-flex">
                        <i class="bi bi-award me-3 fs-4 text-warning"></i>
                        Güncel, bakımlı ve genç filo.
                    </li>
                    <li class="list-group-item px-0 d-flex">
                        <i class="bi bi-headset me-3 fs-4 text-warning"></i>
                        7/24 destek ve yol yardım.
                    </li>
                </ul>
            </div>
        </div>
    </div>
</section>

<!-- Zaman Çizelgesi -->
<section class="bg-light py-5">
    <div class="container py-5">
        <h2 class="h3 fw-bold mb-4">Kilometre taşlarımız</h2>
        <div class="row row-cols-1 row-cols-md-4 g-3">
            <div class="col">
                <div class="card h-100 border-0 shadow-sm rounded-4">
                    <div class="card-body">
                        <span class="badge bg-dark mb-2">2004</span>
                        <p class="mb-0">Kuruluş ve ilk şube.</p>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card h-100 border-0 shadow-sm rounded-4">
                    <div class="card-body">
                        <span class="badge bg-dark mb-2">2012</span>
                        <p class="mb-0">Filo 25 araca ulaştı.</p>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card h-100 border-0 shadow-sm rounded-4">
                    <div class="card-body">
                        <span class="badge bg-dark mb-2">2018</span>
                        <p class="mb-0">7/24 destek hattı.</p>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card h-100 border-0 shadow-sm rounded-4">
                    <div class="card-body">
                        <span class="badge bg-dark mb-2">2025</span>
                        <p class="mb-0">Akıllı rezervasyon ve online iade.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA -->
<section class="py-5">
    <div class="container py-5">
        <div class="p-4 p-md-5 bg-dark text-light rounded-4 d-flex flex-column flex-md-row align-items-md-center justify-content-between">
            <div class="mb-3 mb-md-0">
                <h3 class="fw-bold mb-1">Hazır mısın?</h3>
                <p class="mb-0 text-light opacity-75">Uygun fiyatlı ve güvenli kiralama için hemen teklif al.</p>
            </div>
            <div class="d-flex gap-2">
                <a href="~/Reservation/Create" class="btn btn-warning fw-semibold">Teklif Al</a>
                <a href="~/Contact" class="btn btn-outline-light">Sorun mu var?</a>
            </div>
        </div>
    </div>
</section>
