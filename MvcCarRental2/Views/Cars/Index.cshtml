@model IEnumerable<MvcCarRental2.Web.Domain.Car>
@using System.Globalization

@{
    ViewData["Title"] = "Araçlarımız";
    var tr = new CultureInfo("tr-TR");
}

<div class="container py-4">
    <div class="d-flex flex-wrap align-items-end justify-content-between gap-3 mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">@ViewData["Title"]</h1>
            <div class="text-muted">
                @Model?.Count() @(" araç bulundu")
            </div>
        </div>
    </div>

    <div class="row g-4">
        @foreach (var car in Model ?? Enumerable.Empty<MvcCarRental2.Web.Domain.Car>())
        {
            var title = $"{car?.Model?.Brand?.Name} {car?.Model?.Name}";
            var altText = !string.IsNullOrWhiteSpace(title) ? title : "Araç";
            var priceText = car?.Price != null
                ? String.Format(tr, "{0:C0}", car.Price)
                : "-";
            var imgSrc = !string.IsNullOrWhiteSpace(car?.ImageAdress)
                ? car.ImageAdress
                : Url.Content("~/images/placeholder-car.jpg");
            <div class="col-12 col-sm-6 col-lg-4">
                <div class="card h-100 border-0 shadow-sm">
                    <!-- Görsel -->
                    <div class="ratio ratio-16x9">
                        <img src="@imgSrc"
                             class="w-100 h-100 rounded-top"
                             style="object-fit:cover"
                             alt="@altText"
                             loading="lazy" />
                    </div>

                    <!-- Gövde -->
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title fw-bold mb-1">@title</h5>
                        <p class="mb-2 text-muted small">@car?.PlateNumber</p>

                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <span class="badge bg-light text-dark">
                                <i class="bi bi-calendar me-1"></i> @car?.Year
                            </span>
                            <span class="badge bg-light text-dark">
                                <i class="bi bi-gear me-1"></i> @car?.TransmissionType
                            </span>
                            
                        </div>

                        <div class="mt-auto d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted d-block">Günlük fiyat</small>
                                <span class="fw-bold fs-5">@priceText</span>
                            </div>
                            <a href="@Url.Action("Rent", "Booking", new { carId = car.Id })"
                               class="btn btn-warning fw-semibold rounded-pill">
                                <i class="bi bi-calendar2-check me-1"></i> Şimdi Kirala
                            </a>
                        </div>
                    </div>

                    <!-- Footer -->
                    <div class="card-footer bg-transparent border-0">
                        <div class="d-flex flex-wrap gap-2">
                            <span class="badge bg-secondary-subtle text-dark">
                                <i class="bi bi-shield-check me-1"></i> Bakımlı
                            </span>
                            <span class="badge bg-secondary-subtle text-dark">
                                <i class="bi bi-geo-alt me-1"></i> Teslime hazır
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
