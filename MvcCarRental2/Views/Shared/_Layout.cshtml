<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Super MvcCarRental2</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr" crossorigin="anonymous">
    <link rel="stylesheet" href="~/MvcCarRental2.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light fixed-top bg-dark bg-opacity-25">
            <div class="container">
                <a class="navbar-brand d-flex flex-column text-center text-white text-decoration-none" asp-area="" asp-controller="Home" asp-action="Index">
                    <div class="fs-1 fw-bold lh-1 mb-1">E&A</div>
                    <div class="small fw-light">MOTORS</div>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse justify-content-end" id="mainNav">
                    <ul class="navbar-nav gap-3">
                        <li class="nav-item">
                            <a class="nav-link text-white fw-bold px-3" asp-area="" asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white fw-bold px-3" asp-area="" asp-controller="Cars" asp-action="Index">Araçlar</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white fw-bold px-3" asp-area="" asp-controller="Home" asp-action="AboutUs">Hakkımızda</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white fw-bold px-3" asp-area="" asp-controller="Home" asp-action="Contact">İletişim</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <section class="position-relative text-light">
            <img src="~/images/banner1.png" class="img-fluid w-100 vh-50 object-fit-cover" alt="Hero">

            <div class="position-absolute top-50 end-0 translate-middle-y text-end p-4">
                <h6 class="fw-light">Ekonomik Araç Yeterli Diyenlere</h6>
                <h2 class="fw-bold">En Uygun Fiyatlarla</h2>
                <p>Kiralama İçin Tıklayın.</p>
                <a asp-controller="Cars" asp-action="Index" class="btn btn-warning px-3 py-1 fw-bold">İNCELE</a>
            </div>
        </section>
    </header>

    <div class="container-fluid px-0 pt-5 mt-5">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - E&A Motors - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>